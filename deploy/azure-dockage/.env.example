# Copy to .env beside compose.yaml in the Dockage stack directory.
# Keep .env private; never commit it or paste its values into a support ticket.

# This fork's Forgejo workflow publishes the image to public GHCR. Check that
# /version matches the commit you intend to deploy; then pin its SHA tag/digest.
CALNODE_IMAGE=ghcr.io/bheem1224/calnode:latest

# Bind to loopback when the reverse proxy runs on the VM host. If NPMplus runs
# in another container, use the VM's private IP and have NPMplus proxy to it.
# Keep TCP 3000 closed to the public Internet in the Azure NSG and VM firewall.
CALNODE_BIND_ADDRESS=127.0.0.1

# Identity/callback host and booking-link host. Use the same HTTPS URL unless
# booking pages have a separate public hostname. No trailing slash.
BASE_URL=
PUBLIC_BASE_URL=

# Generate two different values: openssl rand -hex 32 (run twice).
# Keep an offline copy of both; the backup does not contain these secrets.
CALNODE_ENCRYPTION_KEY=
CALNODE_RECOVERY_SECRET=

# Continuous SQLite backup. Pick ONE backend:
# Azure Blob directly (no proxy):
#   LITESTREAM_REPLICA_URL=abs://<storage-account>@calnode-db-backups/calnode
#   LITESTREAM_AZURE_ACCOUNT_KEY=<storage-account-key>
# The bundled Litestream v0.3.13 supports this natively. An Azure storage account
# key can read every container in that account, including CRM backups. Use a
# separate storage account if you need isolation at the credential boundary.
#
# S3-compatible endpoint or S3-to-Azure proxy:
#   LITESTREAM_REPLICA_URL=s3://calnode-db-backups/calnode
#   LITESTREAM_ENDPOINT=http://<proxy-service>:<port> (no bucket in endpoint)
#   LITESTREAM_ACCESS_KEY_ID / SECRET_ACCESS_KEY = dedicated proxy credentials
#   LITESTREAM_REGION = the region accepted by the proxy (not Azure's region).
# Only a separate, container-scoped Azure identity or credential on the proxy
# isolates CRM backups from Calnode when both share one storage account.
LITESTREAM_REPLICA_URL=
LITESTREAM_AZURE_ACCOUNT_KEY=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Optional: exact IP/CIDR of a trusted reverse proxy. Do not use 0.0.0.0/0.
# Without this, per-IP rate limits see the proxy as one client.
TRUSTED_PROXY_CIDRS=

# Set SMTP here OR configure a transactional mail provider in Settings -> Email.
# Booking confirmation emails require one working delivery route. For port 587,
# use STARTTLS=true and TLS=false. Leave these empty when using the UI provider.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_TLS=false
EMAIL_SMTP_STARTTLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Calnode

# Microsoft Entra, Google, and generic OIDC providers are configured in
# Settings -> Identity & integrations after first-run owner setup.
